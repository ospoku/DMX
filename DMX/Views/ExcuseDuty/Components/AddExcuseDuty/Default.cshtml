
@model DMX.ViewModels.AddExcuseDutyVM






  

<dialog id="AddExcuseDutyDialog" class="border-0 rounded p-0 col-md-4">

            <div class="modal-header">
                <h6 class="fw-bold">Add Excuse Duty</h6>
                <button type="button" aria-label="Close" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('AddExcuseDutyDialog').close()">Close</button>
    </div>  @using (Html.BeginForm("AddExcuseDuty", "ExcuseDuty", FormMethod.Post, new { id = "addExcuseDutyForm" }))
    {
            <div class="modal-body">
                    <div class="row">
                <div class="col-md-8">
                <div class="input-group">
                    <div class="input-group-text">
                        <i class="fas fa-user-doctor"></i>        
                    </div>
                    <div class="did-floating-label-content">
                            <input type="text" asp-for="@Model.PatientName"
                               class="did-floating-input"
                                   id="txtPatientName"
                               placeholder=" " />
                            <label class="did-floating-label" for="txtPatientName">Patient Name</label>
                    </div>
                </div>
                </div>
                        <div class="col-md-4">
                    <div class="input-group">
                        <div class="input-group-text">
                            <i class="fas fa-user-check"></i>   
                        </div>
                        <div class="did-floating-label-content">
                            <input type="text" asp-for="@Model.PatientId"
                                   class="did-floating-input"
                                   id="txtPatientId"
                                   placeholder=" " />
                            <label class="did-floating-label" for="txtPatientId">Patient Id</label>
                        </div>
                    </div>
                        </div>
                    </div>
            <div class="input-group">
                <div class="input-group-text">
                <i class="fas fa-diagnoses"></i>
                </div>
                <div class="did-floating-label-content">
                <input type="text" class="did-floating-input" asp-for="@Model.Diagnosis" placeholder="" required />
                    <label class="did-floating-label">Diagnosis</label>
                    </div>
                    </div>
                    <div class="input-group">
                <div class="input-group-text">
                    <i class="fas fa-calendar"></i>
                </div>      
                <div class="did-floating-label-content">
                        <input class="did-floating-input" type="date" asp-for="@Model.DateofDischarge"  required name="dtDateofDischarge" />
                        <label class="did-floating-label" for="dtDateofDischarge">Date of Discharge</label>
                       </div>
                    </div>
            <div class="input-group">
                <div class="input-group-text">
                    <i class="fas fa-calendar-day"></i>
                </div>
                <div class="did-floating-label-content">
                        <input class="did-floating-input" type="number"  asp-for="@Model.ExcuseDays" placeholder="" required />
                        <label class="did-floating-label" >Excuse Days</label>
                     
                    </div>
                    </div>
           
             
                        <select id="usersAddExcuseDuty" class="dmx-choices" asp-items="@Model.UsersList" asp-for="@Model.SelectedUsers"><option value="">Select User(s)</option></select>
                   
                    </div>
                    <div class="modal-footer">
                        <button id="btnAddExcuseDuty" class="btn btn-primary btn-block">Save</button>
                    </div>
                }
</dialog>



