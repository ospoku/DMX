
@model DMX.ViewModels.EditMemoVM;

<div class="modal fade" id="EditMemo" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">

        <div class="modal-content">
            <div class="modal-header">

                <h6>Edit Memo</h6>
                <button type="button" onclick="document.getElementById('EditMemo').close()" class="btn btn-sm btn-outline-danger">Close</button>
            </div>
            <div class="modal-body">


                        @using(Html.BeginForm("EditMemo", "Memo", FormMethod.Post))
                        {
                

                            <div class="floating-group">
                                <input  asp-for="@Model.Title" placeholder="" />
                                <label >Title</label>
                            </div>
                  
                     <div class="form-group">     
                    <textarea id="EditContent"  type="text" placeholder="Current Diagnoses" asp-for="@Model.Content" required="required"></textarea>

                    </div>

                   
                            <div class="floating-group">
                                    <select id="selectUser" class="did-floating-select" asp-items="@Model.UsersList" asp-for="@Model.SelectedUsers" multiple ></select>
                               <label >Select User(s)</label>
                            </div>
                       
                                <button class="btn btn-block btn-primary">Update</button>
                          
                      
                  
      }
     </div>
     </div>
     </div>
     </div>
     <script>
   
         $(document).ready(function () {
                    $('#selectUser').select2({
                        dropdownParent: $('#EditMemo')
                    });

         
         const editContent='#EditContent';

      $(editContent)
        .off('shown.bs.modal') // Prevent duplicate event handlers
        .on('shown.bs.modal', function () {
            if (!tinymce.get(memoContentSelector.substring(1))) { // Initialize only if not already initialized
                try {
                    tinymce.init({
                        selector: memoContentSelector,
                        menubar: true,
                        toolbar: 'undo redo | bold italic underline | alignleft aligncenter alignright',
                        height: 300 // Default height for consistency
                    });
                } catch (e) {
                    console.error('Error initializing TinyMCE:', e);
                }
            }
        });

    // Remove TinyMCE instance on modal close
    $(editContent)
        .off('hidden.bs.modal') // Prevent duplicate event handlers
        .on('hidden.bs.modal', function () {
            try {
                tinymce.remove(memoContentSelector);
            } catch (e) {
                console.error('Error removing TinyMCE:', e);
            }
        });
        });
    </script>
