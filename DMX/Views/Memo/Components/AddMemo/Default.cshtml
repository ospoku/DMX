@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model DMX.ViewModels.AddMemoVM


    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card rounded shadow-sm">
                <div class="card-header py-3 px-3">
                    <i class="fas fa-fw fa-file-alt"></i>
                    <h6 class="m-0 fw-bold text-primary d-inline">Memos</h6>
                </div>

                <div class="card-body">
                    @using (Html.BeginForm("AddMemo", "Memo", FormMethod.Post, new { id = "addMemoForm" }))
                    {
                        <!-- Memo Title -->
                        <div class="input-group mb-3">
                            <span class="input-group-text">
                                <i class="fas fa-heading"></i>
                            </span>
                            <div class="did-floating-label-content flex-grow-1">
                                <input type="text" asp-for="Title"
                                       class="did-floating-input"
                                       id="title"
                                       placeholder=" " />
                                <label class="did-floating-label" for="title">Title</label>
                            </div>
                        </div>

                        <!-- Memo Content -->
                        <div class="mb-3">
                            <textarea id="MemoContent" class="dmx-textarea form-control" asp-for="Content" placeholder="Memo Content"></textarea>
                        </div>

                        <!-- Select Approvers -->
                        <div class="mb-3">
                            <select id="selectMemoUser" class="dmx-choices" asp-items="@Model.UsersList" asp-for="SelectedUsers" multiple>
                            </select>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid">
                            <button id="saveButton" type="submit" class="btn btn-primary">Save</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
