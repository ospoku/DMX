@model DMX.ViewModels.CommentVM

<div class="modal fade" id="CommentModal" tabindex="-1"
     aria-labelledby="CommentModalLabel"
     aria-hidden="true"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h6 id="CommentModalLabel">Comments</h6>

                <button type="button"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        class="btn btn-sm btn-outline-danger">
                    Close
                </button>
            </div>

            <div class="modal-body">

                <ul class="nav nav-pills nav-fill gap-2 p-1 bg-primary rounded-1"
                    role="tablist">

                    <li class="nav-item">
                        <button class="nav-link active"
                                data-bs-toggle="pill"
                                data-bs-target="#comment-list"
                                type="button">
                            Comments
                            <span class="badge bg-danger">
                                @Model.CommentCount
                            </span>
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link"
                                data-bs-toggle="pill"
                                data-bs-target="#new-comment"
                                type="button">
                            New Comment
                        </button>
                    </li>

                </ul>

                <div class="tab-content p-2">

                    <!-- Existing Comments -->
                    <div class="tab-pane fade show active"
                         id="comment-list">

                        @if (Model.Comments.Any())
                        {
                            foreach (var comment in Model.Comments)
                            {
                                var picture = comment.Picture != null
                                    ? $"data:image/png;base64,{Convert.ToBase64String(comment.Picture)}"
                                    : Url.Content("~/images/default-user.png");

                                <div class="card mb-3">
                                    <div class="card-body d-flex align-items-start">

                                        <img src="@picture"
                                             alt="User picture"
                                             class="rounded-circle me-3"
                                             style="width:40px;height:40px;object-fit:cover;" />

                                        <div class="flex-grow-1 comment-content">

                                            <div class="d-flex justify-content-between">
                                                <small class="fw-bold">
                                                    @comment.Fullname
                                                </small>

                                                <small>
                                                    <time class="timeago"
                                                          datetime="@comment.CreatedDate?.ToString("o")">
                                                    </time>
                                                </small>
                                            </div>

                                            <p class="mb-0">
                                                @comment.Message
                                            </p>

                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center py-3">
                                No comments have been added.
                            </p>
                        }

                    </div>

                    <!-- New Comment -->
                    <div class="tab-pane fade" id="new-comment">

                        <form method="post"
                              asp-controller="Comment"
                              asp-action="AddComment">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   asp-for="RecordPublicId" />

                            <input type="hidden"
                                   asp-for="ModuleId" />

                            <div class="mb-3">
                                <textarea asp-for="NewComment"
                                          id="newComment"
                                          class="form-control"
                                          placeholder="Write your comment here..."
                                          rows="5"></textarea>
                            </div>

                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Comment
                            </button>

                        </form>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .comment-content {
        overflow-wrap: anywhere;
    }
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const modal = document.getElementById('CommentModal');
    const editorId = 'newComment';

    if (!modal) return;

    modal.addEventListener('shown.bs.modal', function () {

        if (!tinymce.get(editorId)) {
            tinymce.init({
                selector: '#' + editorId,
                menubar: false,
                toolbar: 'undo redo | bold italic underline | alignleft aligncenter alignright',
                height: 250
            });
        }

        if (window.jQuery && jQuery.fn.timeago) {
            jQuery(modal).find('time.timeago').timeago();
        }
    });

    modal.addEventListener('hidden.bs.modal', function () {
        const editor = tinymce.get(editorId);

        if (editor) {
            editor.remove();
        }
    });

    });
    </script>